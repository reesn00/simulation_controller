<View>
  <Header value="Task $task_id · Session $session_id"/>
  <Header value="质量分 $training_value_score（$complexity_tier）"/>

  <!-- 隐藏锚点。LS 1.23 的 <TextArea> 是**控件**标签, 强制要求 toName 指向一个
       真实存在的 tag, 缺了直接 "Validation failed on : 'toName' is a required
       property"(且不告诉你是哪一个, 只能逐个试)。下面所有只读展示块、task /
       revise_notes 都挂在它身上。$task_id 是纯字符串且恒在, visible=false 不
       占版面。 -->
  <Text name="task_anchor" value="$task_id" visible="false"/>

  <!-- 分区。**原设计用 <Tabs>/<Tab> 分页, 实测这两个标签在本机 LS 1.23 里
       没注册**, 标注页直接报 "Tag with name tabs is not registered"。
       改成 <Header> 分隔, 平铺但一定渲染得出来。
       同理 <TextEditor> 也不是合法的 LS 标签名 —— 只读展示一律用
       <TextArea editable="false">。这两条由 test_only_registered_tags_used
       静态守住, 不要改回去。 -->

  <!-- 低分标记。排在最前面: 它解释了后面所有低分维度的成因, 藏在末尾等于
       没写。$audit_text 由 task_exporter 恒提供 (未拒收时写「（无）」), 所以这
       块永远不会是空白框 —— 空白框分不清是"没被拒收"还是"渲染坏了"。
       editable=false: 机器的判定, 标注员改它等于抹掉审计痕迹; 要表达异议
       走下面的 overall_decision / revise_notes。 -->
  <Header value="══ 低分标记 ══  本样本被 gdr 拒收过则显示理由，请重点复核「精修质量」维度。"/>
  <TextArea name="audit_view" toName="task_anchor" editable="false" rows="4"
            value="$audit_text"/>

  <Header value="══ 评分卡 ══  自动评分与依据。source=estimated / missing 的维度不可全信，核对后填「指令核对」区。"/>
  <TextArea name="scorecard_view" toName="task_anchor" editable="false" rows="12"
            value="$scorecard_text"/>

  <!-- 风险提示。**这块不只是展示, 它还是 predictions 预标注的唯一落点**:
       LS 按 result[].from_name 匹配控件, 匹配不上就整条静默丢弃 (实测
       import/predictions 回 201 {"created": 0})。控件名与
       task_exporter.RISK_HINTS_CONTROL 必须逐字一致, 由
       test_prediction_control_matches_label_config 守。
       editable=false: 风险提示是机器的判断, 标注员改它等于抹掉审计痕迹 ——
       要表达异议走下面的 criterion_verdict / revise_notes。 -->
  <Header value="══ 风险提示 ══  由评分卡自动生成（方案 §5.2），只做风险提示、不做 accept/reject 预判。"/>
  <TextArea name="risk_hints" toName="task_anchor" editable="false" rows="3"
            value="$risk_hints_text"/>

  <Header value="══ 指令核对 ══  逐条核对自动判定；不认同必填理由。"/>
  <!-- 逐条列表的锚点是 <Text> 而不是 <TextArea>: 控件标签不能自引用
       (name="criterion" toName="criterion"), 那样 import 必失败
       data['criteria']=...。$criteria 是 task_exporter._flatten_criteria 摊平的
       **字符串列表** —— LS 的 perItem 文本控件只接受字符串列表, 传 dict 列表
       必挂。也因此不用 $scorecard.dimensions[?(...)] 过滤语法, 那玩意儿各版本
       行为不一致。 -->
  <Text name="criterion" value="$criteria"/>
  <Filter toName="criterion" name="criterion_filter" minlength="1"/>
  <Choices name="criterion_verdict" toName="criterion" choice="single"
           perItem="true" required="true">
    <Choice value="agree"    hint="认同自动判定"/>
    <Choice value="disagree" hint="不认同，右侧写明理由"/>
  </Choices>
  <TextArea name="criterion_note" toName="criterion" perItem="true"
            placeholder="不同意时写明：应达成什么 / 实际达成了什么"/>

  <Header value="══ 轨迹 ══  C3 messages 视图（只读）"/>
  <TextArea name="messages_view" toName="task_anchor" editable="false" rows="16"
            value="$messages_text"/>

  <Header value="══ ChatML ══  qwenjina 训练视图（只读）"/>
  <TextArea name="qf_text_view" toName="task_anchor" editable="false" rows="16"
            value="$qf_text"/>

  <Header value="══ 元数据 ══  C3 meta.json（只读）"/>
  <TextArea name="metadata_view" toName="task_anchor" editable="false" rows="10"
            value="$metadata_text"/>

  <!-- overall_decision / failure_mode 的锚点。

       **必须是带 value 的 <Text> 数据标签。** <Choices> 要靠 toName 指向的标签
       生成 region; 原来这里是
       <TextArea name="task" toName="task_anchor" maxSubmissions="1" .../>,
       它自己绑在 task_anchor 上、**自身没有 value**, 是个纯控件而不是数据源。
       Choices 拿不到 region source → 点一下整个标注区前端崩成空白页。
       实测症状: 点完 annotations / drafts / results 全是 0, 什么都没存下,
       所以不是"提交后跳到下一条"(那样至少会留下一条标注)。

       对照组是上面的 criterion_verdict —— 它绑的 criterion 是
       <Text value="$criteria">, 有数据源, 工作正常。

       name 仍是 "task", 标注结果 JSON 的 to_name 不变, 已有的标注数据不受影响。
       maxSubmissions 只对 TextArea 有意义, 换成 Text 后没有这个属性。 -->
  <Text name="task" value="$task_id" visible="false"/>

  <Header value="══ 最终判定（必选）══"/>
  <Choices name="overall_decision" toName="task" choice="single" required="true">
    <Choice value="accept"  hint="该轨迹质量达标"/>
    <Choice value="revise"  hint="需修改，备注修复方向"/>
    <Choice value="reject"  hint="拒绝，废弃该样本"/>
  </Choices>

  <Header value="══ 失败模式（选填，选了 reject 建议填）══"/>
  <Choices name="failure_mode" toName="task" choice="multiple" required="false">
    <Choice value="reasoning_error"/>
    <Choice value="tool_use_error"/>
    <Choice value="formatting_error"/>
    <Choice value="hallucination"/>
    <Choice value="policy_violation"/>
    <Choice value="incomplete_response"/>
    <Choice value="other"/>
  </Choices>

  <Header value="══ 修订意见（选填）══"/>
  <TextArea name="revise_notes" toName="task_anchor" maxSubmissions="1"
            placeholder="修复方向 / 修改建议（选填）"/>
</View>
