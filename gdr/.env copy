# GDR Environment Configuration (local llama.cpp server on :9090)

# === HTTP OpenAI-compatible LLM endpoint ===
GDR_LLM_BASE_URL=http://127.0.0.1:9090/v1
GDR_LLM_API_KEY=not-needed

# Model names registered at the endpoint
GDR_MAIN_MODEL=Qwen3.5-9B-UD-Q6_K_XL
GDR_TOOL_MODEL=Qwen3.5-9B-UD-Q6_K_XL
GDR_JUDGE_MODEL=Qwen3.5-9B-UD-Q6_K_XL

# === Embedding model ===
GDR_EMBEDDING_MODEL_NAME=BAAI/bge-m3

# === Validation toggles ===
GDR_ENABLE_L1=true
GDR_ENABLE_L2=true
GDR_ENABLE_L3=true
GDR_ENABLE_LLM_LAYER=true
GDR_ENABLE_TEXT_FACT_CHECK=true

# === Retries ===
GDR_MAX_RETRIES=2

# === Timeouts (seconds) ===
GDR_LLM_TIMEOUT_S=120
GDR_L3_TIMEOUT_S=60

# === IO paths ===
GDR_TOOLS_CONFIG_PATH=./config/tools.yaml
GDR_INPUT_PATH=origindata/0c175024ed9c4bde8e77f7b9dd125f08.json
GDR_OUTPUT_PATH=refine_data/output.json
GDR_LOG_DIR=./logs