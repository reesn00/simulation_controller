# GDR Environment Configuration
# Copy to .env and fill in values

# === HTTP OpenAI-compatible LLM endpoint ===
GDR_LLM_BASE_URL=http://localhost:8000/v1
GDR_LLM_API_KEY=not-needed

# Model names registered at the endpoint (match vLLM / llama.cpp server / etc.)
GDR_MAIN_MODEL=Qwen3.5-9B-Instruct
GDR_TOOL_MODEL=Qwen3.5-32B-Instruct
GDR_JUDGE_MODEL=Qwen3.5-32B-Instruct

# === Embedding model (CPU) ===
GDR_EMBEDDING_MODEL_NAME=BAAI/bge-m3

# === Context / GPU hints (for prompts only; not used to load local GGUF) ===
GDR_N_CTX=8192
GDR_N_GPU_LAYERS=-1

# === Validation toggles ===
GDR_ENABLE_L1=true
GDR_ENABLE_L2=true
GDR_ENABLE_L3=true
GDR_ENABLE_LLM_LAYER=true
GDR_ENABLE_TEXT_FACT_CHECK=true

# === Retries ===
GDR_MAX_RETRIES_9B=2

# === Timeouts (seconds) ===
GDR_LLM_TIMEOUT_S=120
GDR_L3_TIMEOUT_S=60

# === Thresholds ===
GDR_MAX_COMPRESSION_RATIO=0.50
GDR_THOUGHT_MIN_LEN=20
GDR_THOUGHT_MAX_LEN=500
GDR_THOUGHT_MAX_LEN_L1=2000
GDR_CONTEXT_SWITCH_THRESHOLD=3
GDR_REPETITIVE_CALL_THRESHOLD=3
GDR_MESSAGE_HEALTH_MIN_RATIO=0.3
GDR_MAX_FAILURES_BEFORE_SUCCESS=8

# === IO paths ===
GDR_TOOLS_CONFIG_PATH=./config/tools.yaml
GDR_INPUT_PATH=./data/input.json
GDR_OUTPUT_PATH=./refine_data/output.json
GDR_LOG_DIR=./logs

# === Batch / parallel ===
# GDR_BATCH_INPUT_DIR=./data/batch
# GDR_BATCH_OUTPUT_DIR=./data/batch_out
# GDR_WORKERS=4
# GDR_SESSION_TIMEOUT_S=180

# === Strictness ===
GDR_STRICT_CONSISTENCY=true

# === Evaluator ===
GDR_EVALUATOR_OUTPUT_DIR=./evaluator_output
GDR_PROBE_BASE_MODEL_NAME=Qwen/Qwen3.5-9B-Instruct
GDR_PROBE_TRAIN_DATA_DIR=./data/sft_pairs
GDR_EVAL_SET_PATH=./data/eval_set.jsonl
GDR_RETENTION_THRESHOLD=0.97
GDR_REMOVAL_THRESHOLD=0.50
GDR_MAX_FEEDBACK_ITERATIONS=3