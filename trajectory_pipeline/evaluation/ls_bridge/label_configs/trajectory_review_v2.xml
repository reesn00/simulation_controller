<View>
  <Header value="Task $task_id · Sample $sample_id · $status"/>
  <Header value="机器标签 $tags_text"/>

  <!-- 隐藏锚点（照读 v1 trajectory_review.xml 的实测教训, 逐条保留）:
       ① task_anchor —— <TextArea> 是控件标签, 强制要求 toName 指向真实
          存在的 tag, 缺了直接 "Validation failed on : 'toName' is a
          required property"。所有展示块挂在它身上。
       ② task —— 给 <Choices> 用。必须是带 value 的 <Text> 数据标签,
          否则 Choices 拿不到 region source, 点一下标注区崩成空白页。
       隐藏只能靠容器 <View style="display:none">; 属性写在 <Text> 上
          (visible= 等) 是无声无效的。改这里必须先在标注页实测一次。 -->
  <View style="display:none">
    <Text name="task_anchor" value="$task_id"/>
    <Text name="task" value="$task_id"/>
  </View>

  <!-- 时间戳(2026-10-19 增量六十一补):generated_at = 产物落盘时间
       (P3/T 视图 mtime),uploaded_at = 推 LS 瞬间。空串时直接显示
       "(未知)"——不静默吞,fail-closed 暴露数据完整性问题。 -->
  <Header value="══ 时间戳 ══  generated_at = 数据生成 / uploaded_at = 推送 LS"/>
  <TextArea name="generated_at_view" toName="task_anchor" editable="false" rows="1"
            value="$generated_at"/>
  <TextArea name="uploaded_at_view" toName="task_anchor" editable="false" rows="1"
            value="$uploaded_at"/>

  <!-- 分区一律 <Header>: <Tabs>/<Tab>/<List>/<TextEditor> 在本机 LS 1.23
       未注册或什么都不渲染, 实测结论见 v1 label_configs 注释。 -->

  <!-- ═══ 机器判定 ═══  三态: positive(合格) / negative(劣质,重点复核) /
       quarantine(缺判,人工裁决)。开场行由 audit_text 给出。 -->
  <Header value="══ 机器判定与理由 ══  positive=合格 / negative=劣质 / quarantine=缺判待裁决"/>
  <TextArea name="audit_view" toName="task_anchor" editable="true" rows="4"
            value="$audit_text"/>

  <Header value="══ 评分卡 ══  scorecard.v2 自动评分与依据。source=missing 的维度没判出来，不可全信。"/>
  <TextArea name="scorecard_view" toName="task_anchor" editable="true" rows="12"
            value="$scorecard_text"/>

  <!-- 风险提示: predictions 预标注的唯一落点。控件名与
       exporter.RISK_HINTS_CONTROL 必须逐字一致, 由契约测试盯住;
       不一致时 LS 静默丢弃整条预测 (201 {"created": 0})。 -->
  <Header value="══ 风险提示 ══  由评分卡自动生成，只做风险提示、不做 accept/reject 预判。"/>
  <TextArea name="risk_hints" toName="task_anchor" editable="true" rows="3"
            value="$risk_hints_text"/>

  <Header value="══ 轨迹 ══  P3 messages 视图（可改，提交后修正稿存入标注）"/>
  <TextArea name="messages_view" toName="task_anchor" editable="true" rows="16"
            value="$messages_text"/>

  <Header value="══ OpenAI 视图 ══  P3 openai function-calling 训练视图（可改，同上）"/>
  <TextArea name="openai_view" toName="task_anchor" editable="true" rows="16"
            value="$openai_text"/>

  <Header value="══ 元数据 ══  P3 meta 可用性元数据"/>
  <TextArea name="metadata_view" toName="task_anchor" editable="true" rows="10"
            value="$meta_text"/>

  <!-- 下面每个 <Choice> 的 html= 是给人看的标签, value= 是存进标注的键。
       ⚠️ 不要用 alias= —— 它会把 LS 认的选项标识从 value 静默换成 alias。 -->
  <Header value="══ 展示内容核对（必选）══  上面几块你改过没有？"/>
  <Choices name="content_revision" toName="task" choice="single" required="true">
    <Choice value="unchanged" html="原样未改" hint="原样未改，下游用 task.data 原文"/>
    <Choice value="corrected" html="已修正"   hint="已修正，以标注里的修正稿为准"/>
    <Choice value="unusable"  html="内容不可用" hint="内容本身不可用，不要拿它训练"/>
  </Choices>

  <Header value="══ 最终判定（必选）══"/>
  <Choices name="overall_decision" toName="task" choice="single" required="true">
    <Choice value="accept"  html="通过"   hint="该轨迹质量达标"/>
    <Choice value="revise"  html="需修改" hint="需修改，备注修复方向"/>
    <Choice value="reject"  html="拒绝"   hint="拒绝，废弃该样本"/>
  </Choices>

  <Header value="══ 失败模式（选填，选了 reject 建议填）══"/>
  <Choices name="failure_mode" toName="task" choice="multiple" required="false">
    <Choice value="reasoning_error"      html="推理错误"/>
    <Choice value="tool_use_error"       html="工具调用错误"/>
    <Choice value="formatting_error"     html="格式错误"/>
    <Choice value="hallucination"        html="幻觉"/>
    <Choice value="policy_violation"     html="违规"/>
    <Choice value="incomplete_response"  html="回复不完整"/>
    <Choice value="other"                html="其他"/>
  </Choices>

  <!-- LS 1.23 没有条件必填, revise 时事实必填只能写进标题与 placeholder。 -->
  <Header value="══ 修订意见（选填；最终判定选了 revise 时必填）══"/>
  <TextArea name="revise_notes" toName="task_anchor" maxSubmissions="1"
            placeholder="修复方向 / 修改建议（最终判定选了 revise 时必填）"/>
</View>
